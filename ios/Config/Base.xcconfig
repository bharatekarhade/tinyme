// Defaults so a fresh clone still builds for the simulator.
// Per-installer values live in TinyMe.xcconfig (git-ignored); create it from TinyMe.xcconfig.template.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.tinyme
TINYME_DEFAULT_SERVER_URL =
TINYME_PUSH_ENABLED = NO

#include? "TinyMe.xcconfig"

// Shared by the app and its widget so the app can hand the widget its stats.
// Follows the bundle id pattern in TinyMe.xcconfig.template (com.<team>.tinyme).
TINYME_APP_GROUP = group.com.$(DEVELOPMENT_TEAM).tinyme
