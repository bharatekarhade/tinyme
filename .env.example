# Copy this file to .env in the repository root and adjust the values.
# Start with: docker compose --env-file .env -f deploy/docker-compose.yml up --build -d
# Defaults below are for local development only.

# ── Database ─────────────────────────────────────────────

# Database name, created when the Postgres volume is first initialized.
POSTGRES_DB=tinyme

# Postgres user, created on first initialization; also used by the API.
POSTGRES_USER=tinyme

# Postgres password; also used by the API.
# Local dev default. CHANGE THIS on any server other people can reach.
# Changing it after the volume exists does not update the stored password.
POSTGRES_PASSWORD=tinyme

# ── API ──────────────────────────────────────────────────

# Host port for the API (the container listens on 8080).
API_PORT=8080

# Blob storage directory inside the API container.
# Compose mounts the persistent blobs volume here. Outside Docker the default is ./blobs.
TINYME_BLOBS_PATH=/app/blobs

# ── Running the API outside Docker (./mvnw spring-boot:run) ──
# spring-boot:run reads this .env file automatically (see application.yml).
# Compose builds the datasource settings from POSTGRES_* above; outside Docker
# they default to jdbc:postgresql://localhost:5432/${POSTGRES_DB}.
# Postgres is not published to the host by default. Publish 5432 locally
# (see deploy/docker-compose.dev.yml) or point at your own database.

# ── Managed Agents ───────────────────────────────────────
ANTHROPIC_API_KEY=
# Allow startup while some seeded tools do not have handlers yet.
# Provision and reconcile agent configuration on startup. Tests disable this.
TINYME_AGENT_SETUP_ENABLED=true
# Allow replacement of a missing/archived memory store (old memories are not recovered).
TINYME_ALLOW_NEW_MEMORY_STORE=false
# Optional one-time adoption IDs. Database settings take precedence; .env is never rewritten.
ANTHROPIC_ENVIRONMENT_ID=
ANTHROPIC_AGENT_ID=
ANTHROPIC_MEMORY_STORE_ID=
